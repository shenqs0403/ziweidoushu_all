{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ziweidoushu",
  "version": "1.0.0",
  "identifier": "com.linglongopc.ziweidoushu.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../ziweidoushu_web",
    "frontendDist": "../../ziweidoushu_web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "紫微斗数",
        "width": 500,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
